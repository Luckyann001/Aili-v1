{
  "name": "@aili/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev:lan": "AILI_LAN_HOST=$(hostname -I | cut -d\" \" -f1) next dev -H 0.0.0.0",
    "dev:live": "AILI_LIVE=1 next dev -H 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:nodrafts": "playwright test -c playwright.nodrafts.config.ts"
  },
  "dependencies": {
    "@aili/engine": "^0.0.0",
    "@aili/schemas": "^0.0.0",
    "@aili/solvers": "^0.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
