{
  "name": "aili",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aili/web",
    "build": "npm run build -w @aili/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:lan": "npm run dev:lan -w @aili/web",
    "dev:live": "npm run dev:live -w @aili/web",
    "test:e2e": "npm run test:e2e -w @aili/web",
    "test:e2e:nodrafts": "npm run test:e2e:nodrafts -w @aili/web",
    "live-sessions:delete": "node -e \"require('fs').rmSync('live-sessions',{recursive:true,force:true});console.log('Deleted all live session logs (live-sessions/).')\"",
    "author:servo": "node authoring/servo-anatomy/run.mjs",
    "test:e2e:demo": "npm run test:e2e:demo -w @aili/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
